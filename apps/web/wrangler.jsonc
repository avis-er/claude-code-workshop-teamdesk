{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamdesk",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_aGVscGVkLWNvd2JpcmQtMTMwNC5jbGVyay5hY2NvdW50cy5kZXYk"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teamdesk",
      // Filled in by `wrangler d1 create`. Local development ignores the value.
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
